# Database
DATABASE_URL=postgresql://localhost:5432/sentinel

# JWT Secret (change in production!)
SECRET_KEY=change-me-in-production-use-random-string

# NVIDIA NIM free preview endpoint; set AI_PROVIDER=groq to use Groq instead.
AI_PROVIDER=nvidia
NVIDIA_API_KEY=your-nvidia-api-key
NVIDIA_CHAT_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_CHAT_MODEL=stg/nvidia/nemotron-3.5-bolt-e4b
GROQ_API_KEY=
GROQ_CHAT_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_CHAT_MODEL=

# NVIDIA NIM free preview embeddings. The same model is used for ingestion and queries.
NVIDIA_EMBEDDING_API_URL=https://integrate.api.nvidia.com/v1/embeddings
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b
EMBEDDING_DIMENSION=384

# Search Settings
SIMILARITY_THRESHOLD=0.45
TOP_K=5

# Upload
MAX_UPLOAD_SIZE_MB=5
